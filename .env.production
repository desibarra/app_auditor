# ===================================
# VARIABLES DE ENTORNO - PRODUCCIÓN
# ===================================

# Aplicación
NODE_ENV=production
APP_NAME=Sentinel Fiscal
APP_VERSION=1.0.0

# Backend
PORT=4000
API_PREFIX=api

# Base de datos SQLite
DATABASE_PATH=/app/data/saas_fiscal.db

# CORS - Ajustar según tu dominio
CORS_ORIGIN=http://localhost:3000,https://tu-dominio.com

# JWT (Generar secretos seguros en producción)
JWT_SECRET=CAMBIAR_ESTE_SECRET_EN_PRODUCCION_usar_openssl_rand_base64_32
JWT_EXPIRATION=7d

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Uploads
MAX_FILE_SIZE=10485760
UPLOAD_PATH=/app/uploads

# Email (Configurar si usas notificaciones)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=tu-email@gmail.com
# SMTP_PASS=tu-password
# SMTP_FROM=noreply@sentinel.com

# AWS S3 (Opcional para almacenamiento en la nube)
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=tu-access-key
# AWS_SECRET_ACCESS_KEY=tu-secret-key
# AWS_S3_BUCKET=sentinel-uploads

# Logs
LOG_LEVEL=info
LOG_PATH=/app/logs

# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# Seguridad
BCRYPT_ROUNDS=12
SESSION_SECRET=CAMBIAR_ESTE_SECRET_EN_PRODUCCION_usar_openssl_rand_base64_32
